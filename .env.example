# ═════════════════════════════════════════════════════════════════════
# DISEÑOS LUNA — STRIPE CHECKOUT ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════════

# Replace with your actual Stripe Secret Key from https://dashboard.stripe.com/apikeys
# Use sk_test_... for test mode, or sk_live_... for live customer payments.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key

# Optional: Stripe Publishable Key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_stripe_publishable_key
